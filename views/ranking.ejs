<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { title: 'preguntas.faciles — Ranking' }) %>
</head>
<body class="ranking-page">
  <div class="app">
    <div class="topbar">
      <div class="brand">
        <img src="/img/preguntas-faciles-logo.png" alt="preguntas.faciles" class="mark brand-logo">
        Ranking
      </div>
      <nav class="landing-nav" aria-label="Navegación principal">
        <a href="/" class="nav-link">Inicio</a>
        <a href="/ranking" class="nav-link active" aria-current="page">Ranking</a>
      </nav>
    </div>

    <p class="stats-season">
      <%= season.name %> · se reinicia cada <%= season.type %>
    </p>

    <section class="year-end-draw" aria-labelledby="year-end-draw-title">
      <div class="year-end-draw__icon" aria-hidden="true">
        <svg viewBox="0 0 96 96" focusable="false">
          <path d="M25 18H12v10c0 14 9 23 23 25M71 18h13v10c0 14-9 23-23 25" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M25 12h46v25c0 15-10 26-23 26S25 52 25 37V12Z" fill="currentColor"/>
          <path d="M43 63h10v14H43zM32 77h32v8H32z" fill="currentColor"/>
          <path d="M28 86h40v6H28z" fill="currentColor"/>
          <path d="M34 19v17" fill="none" stroke="#FFF1A6" stroke-width="5" stroke-linecap="round" opacity=".8"/>
        </svg>
      </div>
      <div class="year-end-draw__content">
        <h2 id="year-end-draw-title">Sorteo de fin de año</h2>
        <p class="year-end-draw__date">31 de diciembre</p>
        <p class="year-end-draw__description">Los 10 primeros del ranking participarán del sorteo.</p>
      </div>
    </section>

    <% if (previousSeason && previousWinner) { %>
      <section class="previous-winner" aria-label="Ganador de la temporada anterior">
        <span class="stats-kicker">Ganador de la temporada anterior</span>
        <div class="previous-winner-player">
          <span class="avatar avatar-ranking">
            <% if (previousWinner.avatar_data) { %>
              <img src="<%= previousWinner.avatar_data %>" alt="">
            <% } else { %>
              <%= previousWinner.nickname.charAt(0).toUpperCase() %>
            <% } %>
          </span>
          <strong><%= previousWinner.nickname %></strong>
          <span class="previous-winner-points"><%= previousWinner.points %> pts</span>
        </div>
        <span class="previous-winner-season"><%= previousSeason.name %></span>
      </section>
    <% } %>

    <% if (!ranking.length) { %>
      <div class="done-card">Todavía nadie sumó puntos esta temporada. ¡Sé el primero!</div>
    <% } else { %>
      <div class="ranking-list">
        <% ranking.forEach((row, i) => { %>
          <div class="ranking-row">
            <span class="avatar avatar-ranking">
              <% if (row.avatar_data) { %>
                <img src="<%= row.avatar_data %>" alt="">
              <% } else { %>
                <%= row.nickname.charAt(0).toUpperCase() %>
              <% } %>
            </span>
            <span class="pos">#<%= i + 1 %></span>
            <span class="nick"><%= row.nickname %><% if (player && player.nickname === row.nickname) { %> (vos)<% } %></span>
            <span class="avg-time"><%= row.avg_response_time_ms != null ? (row.avg_response_time_ms / 1000).toFixed(1) + 's prom.' : '—' %></span>
            <span class="pts"><%= row.points %> pts</span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="ad-slot">Espacio publicitario</div>
  </div>

  <%- include('partials/bottom-nav', { active: 'ranking' }) %>
</body>
</html>