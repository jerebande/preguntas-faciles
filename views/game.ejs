<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { title: 'Partida — preguntas.faciles' }) %>
</head>
<body class="game-page" data-practice-mode="<%= practiceMode ? 'true' : 'false' %>">
  <div class="app">
    <div class="topbar">
      <div class="brand">
        <img src="/img/preguntas-faciles-logo.png" alt="preguntas.faciles" class="mark brand-logo">
      </div>
      <div class="player-chip" id="playerChip">
        <% if (practiceMode) { %>
          <strong>Modo prueba</strong>
          <a class="practice-exit" href="/">Salir</a>
        <% } else { %>
        <span class="avatar avatar-small" aria-hidden="true">
          <% if (player.avatar_data) { %>
            <img src="<%= player.avatar_data %>" alt="">
          <% } else { %>
            <%= player.nickname.charAt(0).toUpperCase() %>
          <% } %>
        </span>
        <strong id="playerName" class="<%= player.nickname.toLowerCase() === 'jeredev' ? 'rainbow-name' : '' %>"><%= player.nickname %></strong>
        <% } %>
      </div>
    </div>

    <% if (practiceMode) { %>
      <p class="practice-notice">Modo de prueba: tus respuestas y puntos no se guardan ni afectan el ranking o las estadísticas.</p>
    <% } %>
    <section id="gameShell">
      <div class="score-strip">
        <span>Puntos: <strong id="pointsLabel">0</strong></span>
        <span id="questionProgress">Pregunta 1 de <%= practiceMode ? 15 : 10 %></span>
        <span id="seasonLabel"><%= practiceMode ? 'Práctica' : '' %></span>
      </div>

      <div id="gameArea">
        <div class="question-card">
          <div class="question-text">Cargando pregunta...</div>
        </div>
      </div>

      <div class="ad-slot">Espacio publicitario</div>
    </section>
  </div>

  <% if (!practiceMode) { %>
    <%- include('partials/bottom-nav', { active: 'jugar' }) %>
  <% } %>
  <script src="/js/game.js"></script>
</body>
</html>
